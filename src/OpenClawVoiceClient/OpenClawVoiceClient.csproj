<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Windows と Linux の両方をサポートするため multi-TFM を使用 -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clawecho</ToolCommandName>
    <PackageId>ClawEcho</PackageId>
    <Version>0.1.0</Version>
    <Authors>Freeesia</Authors>
    <Description>OpenClaw スマートスピーカー音声クライアント（Raspberry Pi 向け半二重音声クライアント）</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.3.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="NanoWakeWord" Version="1.2.1" />
    <PackageReference Include="NAudio" Version="2.2.1" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
  </ItemGroup>

</Project>
